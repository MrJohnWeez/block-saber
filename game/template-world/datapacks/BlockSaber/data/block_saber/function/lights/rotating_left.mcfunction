# rotating_left group renderer (port of _root_class:handle_lights_left_rotating_lasers_group): one note particle per bs_light_rotating_left fixture marker,
# one score-table hit per tick picks the note hue; the BS colour -> hue table is copied verbatim from the old bodies
execute if score #rotating_left bs_light_color matches 5 at @e[type=minecraft:marker,tag=bs_light_rotating_left] run particle minecraft:note ~ ~ ~ 0 0 0 1 0 force
