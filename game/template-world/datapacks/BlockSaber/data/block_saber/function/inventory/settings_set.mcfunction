# Settings page (contract §2.3 settings medium): the #CONST bs_lightshow / #CONST bs_godmode toggles, port of the
# 1.18 settings_menu + settings_menu_toggle_lightshow/godmode chat menu (defaults from init: lightshow 1,
# godmode 0). Opened from the pause page; reachable while browsing menus - toggling mid-run takes effect live
# because lights/handle and song/hit gate #CONST every tick.
scoreboard players operation @s current_menu = #CONST SETTINGS_MENU
function block_saber:inventory/clear_menu
function block_saber:inventory/menu_filler
item replace entity @s inventory.0 with minecraft:stick[custom_name=[{"text":"Back","color":"blue"}],item_name=[{"text":""}],enchantment_glint_override=true,item_model="blocksaber:blue_dot",custom_data={action:"bs_back",menu_item:1b},tooltip_display={hidden_components:[tooltip_display]}] 1
execute if score #CONST bs_lightshow matches 1 run item replace entity @s inventory.13 with minecraft:stick[custom_name=[{"text":"▆ Light Show: ON","color":"green"}],item_name=[{"text":""}],lore=[{"text":"Drop to toggle the light show","color":"gray","italic":false}],enchantment_glint_override=true,item_model="blocksaber:blue_dot",custom_data={action:"settings_lightshow",menu_item:1b},tooltip_display={hidden_components:[tooltip_display]}] 1
execute if score #CONST bs_lightshow matches 0 run item replace entity @s inventory.13 with minecraft:stick[custom_name=[{"text":"▆ Light Show: OFF","color":"red"}],item_name=[{"text":""}],lore=[{"text":"Drop to toggle the light show","color":"gray","italic":false}],enchantment_glint_override=true,item_model="blocksaber:blue_dot",custom_data={action:"settings_lightshow",menu_item:1b},tooltip_display={hidden_components:[tooltip_display]}] 1
execute if score #CONST bs_godmode matches 1 run item replace entity @s inventory.16 with minecraft:stick[custom_name=[{"text":"▆ God Mode: ON","color":"green"}],item_name=[{"text":""}],lore=[{"text":"Drop to toggle god mode","color":"gray","italic":false}],enchantment_glint_override=true,item_model="blocksaber:blue_dot",custom_data={action:"settings_godmode",menu_item:1b},tooltip_display={hidden_components:[tooltip_display]}] 1
execute if score #CONST bs_godmode matches 0 run item replace entity @s inventory.16 with minecraft:stick[custom_name=[{"text":"▆ God Mode: OFF","color":"red"}],item_name=[{"text":""}],lore=[{"text":"Drop to toggle god mode","color":"gray","italic":false}],enchantment_glint_override=true,item_model="blocksaber:blue_dot",custom_data={action:"settings_godmode",menu_item:1b},tooltip_display={hidden_components:[tooltip_display]}] 1
