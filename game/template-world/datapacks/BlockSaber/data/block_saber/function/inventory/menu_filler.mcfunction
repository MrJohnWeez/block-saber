# Invisible filler pane for every inventory slot; each menu page overwrites the slots its buttons need (port of
# the glass-pane idea the old clear_menu carried commented-out). Fillers make "the menu was opened" detectable:
# exactly one slot loses its menu_item when the player drops a page item, none when the page is intact.
item replace entity @s inventory.0 with minecraft:light_gray_stained_glass_pane[item_name=[{"text":""}],tooltip_display={hide_tooltip:true},item_model="minecraft:air",custom_data={action:void,menu_item:1b}] 1
