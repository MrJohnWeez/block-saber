# Fix syntax highlighting on GitHub to allow comments
.vscode/*.json linguist-language=JSON-with-Comments
tsconfig.json linguist-language=JSON-with-Comments

# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md   text diff=markdown
*.txt  text

# Scripts
*.sh   text eol=lf
*.bash text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Source code
*.css  text diff=css
*.htm  text diff=html
*.html text diff=html
*.js   text
*.mjs  text
*.ts   text

# Serialisation
*.json text
*.toml text
*.xml  text
*.yaml text
*.yml  text

# Configs
package.json      text eol=lf
package-lock.json text eol=lf -diff

# Game and design assets stored as plain Git objects
*.xcf binary
*.ico binary
*.dat binary
*.mca binary
*.nbt binary

# Fonts and archives
*.eot    binary
*.otf    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.zip    binary

# Large media tracked with Git LFS; keep this list in sync with the extensions in `git lfs ls-files`
[attr]lfs filter=lfs diff=lfs merge=lfs -text
*.png  lfs
*.ogg  lfs
